# ── Data (raw & processed) ─────────────────────────
# Dataset downloaded at repo root (OpenNeuro oddball)
/oddball_data/

# Standard layout: keep folders via .gitkeep, ignore contents (keep scripts)
data/raw/oddball_data/*
!data/raw/oddball_data/.gitkeep
data/processed/*
!data/processed/.gitkeep

# EEG / data file formats & partial downloads
*.eeg
*.vhdr
*.vmrk
*.edf
*.bdf
*.set
*.fdt
*.fif
*.npy
*.npz
*.part
*.eeg.*

# ── Results (keep .gitkeep only) ───────────────────
results/*
!results/*/
results/*/*
!results/*/.gitkeep

# ── Model weights / checkpoints ────────────────
*.pt
*.pth
*.pkl
*.ckpt

# ── Logs ───────────────────────────────────────
*.log

# ── Python & environments ──────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ── Jupyter & editors ──────────────────────────
.ipynb_checkpoints/
.vscode/
.idea/

# ── OS ─────────────────────────────────────────
.DS_Store
Thumbs.db
